{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Luozi",
  "version": "0.1.0",
  "identifier": "app.luozi.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "落字 · 语音草稿",
        "width": 760,
        "height": 600,
        "visible": false,
        "skipTaskbar": true
      },
      {
        "label": "overlay",
        "title": "Luozi Overlay",
        "url": "overlay.html",
        "width": 420,
        "height": 64,
        "visible": false,
        "alwaysOnTop": true,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false,
        "transparent": true
      },
      {
        "label": "settings",
        "title": "落字 · 设置",
        "url": "settings.html",
        "width": 760,
        "height": 560,
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "infoPlist": "Info.plist"
    }
  }
}
